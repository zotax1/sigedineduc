# =============================================================================
# SIGED-INEDUC · Variables de entorno (valores de EJEMPLO, no reales)
# Copie este archivo como .env.local y complete los valores de su proyecto.
# Nunca suba .env.local ni claves reales al repositorio.
# =============================================================================

# URL del proyecto de Supabase (Configuración del proyecto → API).
NEXT_PUBLIC_SUPABASE_URL=https://su-proyecto.supabase.co

# Clave PUBLICABLE (sb_publishable_...) o, en proyectos antiguos, la clave "anon".
# Es pública por diseño: la seguridad la garantizan la autenticación y la RLS.
# (Con la integración de Supabase en Vercel también se acepta
#  NEXT_PUBLIC_SUPABASE_ANON_KEY en lugar de esta variable.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplazar

# URL pública de la aplicación (se usa en los enlaces de invitación y recuperación).
NEXT_PUBLIC_SITE_URL=https://siged-ineduc.vercel.app

# Clave SECRETA (sb_secret_...) o "service_role". SOLO servidor. Necesaria para
# invitar/crear/suspender cuentas desde Administración. Nunca la exponga al
# navegador ni use el prefijo NEXT_PUBLIC_.
# También se acepta SUPABASE_SERVICE_ROLE_KEY (nombre de la integración de Vercel).
SUPABASE_SECRET_KEY=sb_secret_reemplazar

# Opcional: secreto para la tarea programada de Vercel (/api/cron/alertas).
# Genere uno aleatorio de al menos 32 caracteres.
CRON_SECRET=reemplazar-por-un-valor-aleatorio-largo
